<style id="wp-custom-css">
/* Masquer la zone de crédits (footer) d'Astra */
.site-info,
.ast-footer-copyright,
.ast-builder-footer .site-info {
  display: none !important;
}
/* Masquer le bouton "Retour en haut" du thème Astra */
#ast-scroll-top,
.ast-scroll-top-icon,
.ast-scroll-top {
  display: none !important;
  visibility: hidden !important;
  opacity: 0 !important;
}
/* 1. Image produit uniforme avec ombre douce */
.woocommerce ul.products li.product a img {
    width: 130px !important;
    height: 180px !important;
    object-fit: cover !important;
    display: block !important;
    border-radius: 10px !important;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1) !important;
    margin: 0 auto !important; /* centrer image */
}

/* 2. Box produit flex vertical avec bouton toujours en bas */
.woocommerce ul.products li.product {
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    align-items: flex-start !important;
    height: 390px !important; /* régler la hauteur de la box */
    width: 220px !important;  /* régler la largeur de la box */
    padding: 10px !important;
    border-radius: 22px !important;
    margin-bottom: 20px !important;
    box-sizing: border-box !important;
    background-color: #ffffff !important;
    box-shadow: 0 6px 15px rgba(0,0,0,0.1) !important;
    position: relative !important; /* important pour le bouton en bas */
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.woocommerce ul.products li.product:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.4) !important;
}

/* 3. Titre limité à 2 lignes avec couleurs */
.woocommerce ul.products li.product .woocommerce-loop-product__title {
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important; /* limite à 2 lignes */
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    margin: 0 !important;
    line-height: 1.2em !important;
    max-height: 2.4em !important; /* 2 lignes * line-height */
    width: 100%;
    color: #333333 !important; /* couleur du titre */
    font-weight: 600 !important;
}

/* Prix du produit */
.woocommerce ul.products li.product .price {
    color: #000000 !important; /* couleur du prix corrigée */
    font-weight: bold !important;
    margin: 5px 0 !important;
}

/* Étoiles collées au texte */
.woocommerce ul.products li.product .star-rating {
    margin: 0 !important;
    padding: 0 !important;
}

/* 4. Bouton aligné en bas de la box */
.woocommerce ul.products li.product .button {
    position: absolute !important;
    bottom: 15px !important; /* espace par rapport au bas */
    left: 50% !important;
    transform: translateX(-50%) !important; /* centré horizontalement */
    background-color: #0b3 !important;
    color: #fff !important;
    border-radius: 20px !important;
    padding: 10px 50px !important;
    display: block !important;
    text-align: center !important;
    box-shadow: 0 4px 8px rgba(0,0,0,0.08);
    transition: background-color 0.3s ease, transform 0.2s ease;
}

.woocommerce ul.products li.product .button:hover {
    background-color: #095017 !important;
    transform: translateX(-50%) translateY(-2px);
}

/* Responsive tablette */
@media(max-width:1024px) {
    .woocommerce ul.products li.product {
        height: auto !important;
        width: 48% !important;
    }
    .woocommerce ul.products li.product .button {
        position: relative !important; /* bouton normal sur tablette si auto-height */
        transform: none !important;
        bottom: auto !important;
        left: auto !important;
        margin-top: auto !important;
    }
}

/* ✅ Responsive mobile : 2 colonnes centrées et texte réduit */
@media(max-width:768px) {
    .woocommerce ul.products {
        display: flex !important;
        flex-wrap: wrap !important;
        justify-content: center !important; /* centrer les produits */
        gap: 10px !important;
    }

    .woocommerce ul.products li.product {
        width: 45% !important; /* 2 produits par ligne */
        height: auto !important;
        margin: 10px auto !important;
    }

    .woocommerce ul.products li.product .woocommerce-loop-product__title {
        font-size: 13px !important; /* taille réduite */
    }

    .woocommerce ul.products li.product .price {
        font-size: 12px !important; /* taille réduite */
    }

    .woocommerce ul.products li.product .button {
        font-size: 13px !important;
        padding: 8px 20px !important;
    }
}



</style>
</head>

