<script>
document.addEventListener("DOMContentLoaded", function() {
  const sousContainer = document.querySelector('.sous-container-fixe');
  const footer = document.querySelector('.mon-footer'); // ton footer avec la classe ajoutée

  if (sousContainer && footer) {
    window.addEventListener('scroll', function() {
      const footerRect = footer.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // Si le footer devient visible, cacher le container
      if (footerRect.top < windowHeight) {
        sousContainer.classList.add('hidden');
      } else {
        sousContainer.classList.remove('hidden');
      }
    });
  }
});
</script>

