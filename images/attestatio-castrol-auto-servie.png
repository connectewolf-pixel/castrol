<script>
const warning = document.getElementById('centerWarning');

function showWarning() {
  warning.classList.add('show');  // faire apparaître

  setTimeout(() => {
    warning.classList.remove('show'); // disparaître après 2 secondes
  }, 2000);
}

// Affiche le message toutes les 4 secondes
setInterval(showWarning, 4000);
</script>

<script>
document.addEventListener("DOMContentLoaded", function() {
    function setEqualHeight() {
        var products = document.querySelectorAll('.woocommerce ul.products li.product');
        var maxHeight = 0;
        // Reset height
        products.forEach(function(product){
            product.style.height = 'auto';
        });
        // Trouver la hauteur max
        products.forEach(function(product){
            if(product.offsetHeight > maxHeight){
                maxHeight = product.offsetHeight;
            }
        });
        // Appliquer la hauteur max
        products.forEach(function(product){
            product.style.height = maxHeight + 'px';
        });
    }

    setEqualHeight();
    window.addEventListener('resize', setEqualHeight);
});
</script>
